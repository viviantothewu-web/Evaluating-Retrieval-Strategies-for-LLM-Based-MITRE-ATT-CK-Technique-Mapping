import time

for i, row in bow_eval.iterrows():

    # Skip already completed queries
    if pd.notna(row["llm_prediction"]):
        continue

    prompt = build_prompt(
        row["sentence"],
        row["bow_candidates"]
    )

    try:
        raw_response = call_llm(prompt)

        prediction = extract_attack_id(
            raw_response
        )

        valid = prediction_in_candidates(
            prediction,
            row["bow_candidates"]
        )

        # Count as correct ONLY if Gemini selected
        # a supplied candidate AND it matches ground truth
        correct = (
            prediction == row["technique_id"]
            and valid
        )

        bow_eval.at[i, "llm_raw_response"] = raw_response
        bow_eval.at[i, "llm_prediction"] = prediction
        bow_eval.at[i, "valid_candidate"] = valid
        bow_eval.at[i, "llm_correct"] = correct

        # Save after every successful request
        bow_eval.to_pickle(
            "bow_llm_results.pkl"
        )

        print(
            f"Completed {i}: "
            f"prediction={prediction}, "
            f"correct={correct}"
        )

        time.sleep(15)

    except Exception as e:

        print(f"Stopped at row {i}")
        print("Error:", e)

        bow_eval.to_pickle(
            "bow_llm_results.pkl"
        )

        break


